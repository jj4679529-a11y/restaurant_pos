# Backend only: replace placeholders locally; never commit real credentials.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/restaurant_pos
APP_NAME="Restaurant POS"
APP_ENV=development
DEBUG=false
PRODUCT_MEDIA_DIR=media/products
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OUTBOX_BATCH_SIZE=50

# Seed bootstrap: set a strong password before creating an administrator.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Optional actual menu prices (integer UZS); do not invent restaurant prices.
OSH_HALF_PRICE=
OSH_FULL_PRICE=
EGG_ONE_PRICE=
EGG_TWO_PRICE=
QAZI_PRICE=
GOSHT_MANUAL_PRESETS=[]
JIZZ_MANUAL_PRESETS=[]

# Desktop terminals need ONLY these POS_* settings, never backend secrets.
POS_API_BASE_URL=http://127.0.0.1:8000
POS_SERVER_START_TIMEOUT_SECONDS=45
AUTO_START_WITH_WINDOWS=false
POS_PRINTER_ID=
POS_API_TIMEOUT_SECONDS=10
